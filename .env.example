# copie este arquivo para .env e substitua as senhas locais
USER_DB_NAME=users_db
USER_DB_USER=postgres
USER_DB_PASSWORD=troque_esta_senha
USER_DB_PORT=5433

# chave aleatoria para o .env local, compartilhada entre MS1 e MS2
INTERNAL_AUTH_KEY=

TRANSACTION_DB_NAME=transactions_db
TRANSACTION_DB_USER=postgres
TRANSACTION_DB_PASSWORD=troque_esta_senha
TRANSACTION_DB_PORT=5434

# Use a URL base fornecida pelo seu projeto no MockAPI, sem /accounts.
MOCK_API_BASE_URL=https://SEU_PROJETO.mockapi.io/api/v1
USER_SERVICE_BASE_URL=http://localhost:8080
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
